# Copy to backend/.env for local development. backend/.env is gitignored.

# Required. The app refuses to start without it. This value is a placeholder
# for local use only; generate a real one for any shared or deployed server:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-not-a-secret-replace-me

# Defaults to False when unset. Turn on for local development only.
DJANGO_DEBUG=True

# Comma-separated hostnames this server answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB connection string. The path names the database. The default matches
# the replica set in the repository's docker-compose.yml.
MONGODB_URI=mongodb://localhost:27017/subtrak

# Optional. Pins "today" for every user, so the seed dataset (04 §4) shows the
# figures it was written for. Leave unset to use each user's local date.
# SUBTRAK_TODAY=2026-10-01

# ---------------------------------------------------------------------------
# Outside services
#
# All optional. Leave one unset and that feature falls back to its local
# stand-in, so a checkout with no keys still starts and still passes the
# tests. Real values go in backend/.env, which is gitignored; never commit a
# key, and never paste one into a log, a PR or a session note.
# ---------------------------------------------------------------------------

# Redis: the Celery broker and the shared cache for rate-limit counters and
# resend cooldowns. Set it to use the redis service in docker-compose.yml.
# Unset, the cache stays per-process and /health/ reports redis as down,
# which is accurate -- with no broker there is no worker, so nothing on the
# beat schedule runs. Tasks such as email then run inline in the request,
# even if compose's Redis is up. The worker itself falls back to this URL.
# REDIS_URL=redis://localhost:6379/0

# Resend API key. Unset, mail goes to the console backend as it does today.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Sender address on every outgoing mail. Must be onboarding@resend.dev or an
# address at a domain verified in Resend, or sends are rejected.
# DJANGO_DEFAULT_FROM_EMAIL=SubTrak <onboarding@resend.dev>

# Public HTTPS origin of this backend, no trailing slash. Emailed links point
# here (many mail apps refuse a subtrak:// link) and Google redirects the
# Gmail OAuth callback here. Unset, emails link straight into the app.
# SUBTRAK_PUBLIC_BASE_URL=https://subtrak-api.onrender.com

# Deep-link prefix the emailed and OAuth bridge pages hand off to.
# SUBTRAK_APP_LINK_PREFIX=subtrak://

# Expo push access token. Optional; Expo accepts unauthenticated sends.
# EXPO_ACCESS_TOKEN=

# Anthropic key and model for extraction and the insight card. Server-side
# only: this never reaches the mobile client.
# LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=

# Kill switch and per-user daily cap for the Gmail scan, so one bad day cannot
# run up a bill. Defaults are true and 30.
# EXTRACTION_ENABLED=true
# EXTRACTION_DAILY_CAP=30

# Google OAuth, a Web application client with the read-only Gmail scope
# (https://www.googleapis.com/auth/gmail.readonly). The secret stays here, on
# the backend. REDIRECT_URIS is a comma-separated exact-match allowlist.
# GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URIS=https://subtrak-api.onrender.com/api/v1/integrations/gmail/callback

# Fernet key encrypting stored Gmail refresh tokens. No default on purpose:
# without it, Gmail stops working rather than encrypting with a known key.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# GMAIL_TOKEN_ENCRYPTION_KEY=
