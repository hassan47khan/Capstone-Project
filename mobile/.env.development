# Team default for `npm start`. Expo loads this automatically in development.
#
# Mocks are ON by default because the backend does not implement these endpoints
# yet (it is still a scaffold). This file is committed on purpose so a teammate
# can clone and run the app with no setup. It holds no secrets.
#
# To point at a real API, copy .env.example to .env.local and set the values
# there — .env.local wins over this file and is gitignored.

EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_USE_MOCKS=true
