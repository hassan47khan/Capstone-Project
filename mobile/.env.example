# SubTrak mobile — environment template.
#
# Copy to `.env.local` for personal overrides. `.env.local` is gitignored;
# this file and `.env.development` are committed because they hold no secrets.
#
# Everything prefixed EXPO_PUBLIC_ is INLINED INTO THE JS BUNDLE at build time
# and ships to the device. Never put a secret, key or token in this file.

# Base URL of the SubTrak API, including the version prefix.
# On a physical phone this must be your machine's LAN IP — `localhost` resolves
# to the phone itself, not your computer.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# "true" serves every request from the in-app mock transport (src/test/routes.ts)
# so the client runs with no backend at all. "false" talks to EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_USE_MOCKS=true

# Gmail (handoff 11 §2.1). The Google OAuth Web-application client id, and the
# backend's callback page, which must also be in the backend's
# GOOGLE_OAUTH_REDIRECT_URIS. Neither is a secret. Leave unset to skip Gmail.
# Real Gmail needs a dev build (npx expo run:android): the callback comes back on
# subtrak://gmail-callback, and Expo Go only answers exp:// links, so in Expo Go
# the browser never hands the code back. With mocks on, Expo Go is fine.
# EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=1234-abc.apps.googleusercontent.com
# EXPO_PUBLIC_GMAIL_REDIRECT_URI=https://your-backend.onrender.com/integrations/gmail/callback
